{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PY}} -I \"{{VAULT}}/_system/command_guard.py\" --client codex"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "{{PY}} -I \"{{VAULT}}/_system/write_guard.py\" --client codex"
          }
        ]
      }
    ]
  }
}
